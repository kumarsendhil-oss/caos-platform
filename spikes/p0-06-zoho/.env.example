# Copy this to .env and fill in real values. .env must be gitignored.

ZOHO_DC=in                          # in | com | eu | com.au | jp | ca | com.cn | sa
ZOHO_CLIENT_ID=1000.XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
ZOHO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ZOHO_ORG_ID=<your-org-id>

# One-time only — used by get_tokens.py, then can be deleted.
# Self Client grant codes expire in minutes, so fill this in right before running.
ZOHO_GRANT_CODE=

# Populated automatically by get_tokens.py into tokens.json — not needed here.
