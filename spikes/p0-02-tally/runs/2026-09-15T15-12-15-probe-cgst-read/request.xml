<ENVELOPE>
  <HEADER>
    <VERSION>1</VERSION>
    <TALLYREQUEST>EXPORT</TALLYREQUEST>
    <TYPE>COLLECTION</TYPE>
    <ID>CAOS Ledger Dump</ID>
  </HEADER>
  <BODY>
    <DESC>
      <STATICVARIABLES>
        <SVEXPORTFORMAT>$$SysName:XML</SVEXPORTFORMAT>
        <SVCURRENTCOMPANY>Coastal Test Traders</SVCURRENTCOMPANY>
      </STATICVARIABLES>
      <TDL>
        <TDLMESSAGE>
          <COLLECTION NAME="CAOS Ledger Dump" ISINITIALIZE="Yes">
            <TYPE>Ledger</TYPE>
            <FETCH>*</FETCH>
            <FILTER>CAOSLedgerName</FILTER>
          </COLLECTION>
          <SYSTEM TYPE="Formulae" NAME="CAOSLedgerName">$Name = "CGST"</SYSTEM>
        </TDLMESSAGE>
      </TDL>
    </DESC>
  </BODY>
</ENVELOPE>