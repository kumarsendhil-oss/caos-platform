# Copy this to .env and fill in real values. .env must be gitignored.
#
# Both come from the app you create at https://www.dropbox.com/developers/apps
# — see README.md. Neither is a per-client credential: this spike uses a single
# dev app against a throwaway Dropbox account, NOT the practice's real Dropbox.

DROPBOX_APP_KEY=<your-app-key>
DROPBOX_APP_SECRET=<your-app-secret>

# Generated from the app console ("Generate access token"). Short-lived tokens
# are the Dropbox default now; if yours expires mid-spike, regenerate it —
# OAuth refresh is ZB-01-shaped work and deliberately out of scope for P0-07.
DROPBOX_ACCESS_TOKEN=<your-access-token>
