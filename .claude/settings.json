{
  "permissions": {
    "deny": [
      "Bash(*git*push*--force*)",
      "Bash(*git*push*-f)",
      "Bash(*git*push*-f *)",
      "PowerShell(git push*--force*)",
      "PowerShell(git push*-f)",
      "PowerShell(git push*-f *)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_python.py\""
          },
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/post_edit_docs.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "shell": "bash",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_dangerous_bash.py\""
          }
        ]
      }
    ]
  }
}
