# Copy to .env and fill in real values for local development.
# In deployed environments, these come from AWS Secrets Manager (Security
# Standard §3), never committed here with real values.

ENVIRONMENT=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-to-a-real-random-secret

# --- Database ---
# Local dev default (SQLite) needs no changes. Production points at
# Postgres on AWS RDS, ap-south-1 (ADR 0007, ADR 0009).
DATABASE_URL=sqlite+aiosqlite:///./caos_dev.db

# --- Redis / Celery (ADR 0003, ADR 0007) ---
REDIS_URL=redis://localhost:6379/0

# --- Books Connector — Tally adapter (ADR 0001) ---
# Leave blank until Dev Readiness Checklist item P0-02 confirms port 9000
# reachability with the Tally Cloud provider.
TALLY_CONNECTOR_HOST=
TALLY_CONNECTOR_PORT=9000

# --- Books Connector — Zoho adapter (ADR 0011) ---
# Register an app at https://api-console.zoho.com/ against the developer
# sandbox once Dev Readiness Checklist item P0-06 is underway.
ZOHO_OAUTH_CLIENT_ID=
ZOHO_OAUTH_CLIENT_SECRET=
ZOHO_OAUTH_REDIRECT_URI=http://localhost:8000/auth/zoho/callback

# --- GSP (ADR 0002) ---
GSP_PROVIDER=whitebooks
GSP_CLIENT_ID=
GSP_CLIENT_SECRET=
GSP_BASE_URL=https://apisandbox.whitebooks.in/gst

# --- Auth (Security Standard §1) ---
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=8

# --- Practice identity (ADR 0010) ---
PRACTICE_ID=venture-assist-srivatsan
PRACTICE_SLUG=venture_assist_srivatsan
